/* ==========================================================================
 * Stile globale essenziale dell'applicazione (Qt Style Sheet)
 * ========================================================================== */

/* Messaggio di errore nei form */
#formErrorLabel {
    color: #f28b82;
}

/* Anteprima live dell'evento in corso di modifica */
#weekPreviewLabel {
    background: rgba(138, 180, 248, 45);
    border: 1px dashed #8ab4f8;
    color: #e8eaed;
    padding: 3px;
    border-radius: 3px;
}

/* Separatori inferiori delle intestazioni della griglia */
#weekHeader, #weekAllDayArea, QLabel#monthDayHeader {
    border-bottom: 1px solid #3c4043;
}

/* Evidenziazione del giorno corrente (stato dinamico) */
QLabel#weekDayHeaderLabel[today="true"],
QLabel#monthDayLabel[dayState="today"] {
    color: #8ab4f8;
    font-weight: bold;
}

/* Testo attenuato per giorni fuori dal mese corrente o etichette orarie */
QLabel#weekHourLabel,
QLabel#monthMoreLabel,
QLabel#monthDayLabel[dayState="outMonth"] {
    color: #9aa0a6;
    font-size: 8pt;
}

/* Vista Mese: celle dei giorni e stato fuori-mese */
app--MonthDayCell {
    border: 1px solid #3c4043;
}
app--MonthDayCell[inMonth="false"] {
    background: #202124;
}

/* Tabella Attività: bordi e padding delle sezioni */
QTableWidget#activityTable {
    border: none;
    outline: none;
}
QTableWidget#activityTable::item {
    padding: 4px 8px;
    border-right: 1px solid #3c4043;
}
QTableWidget#activityTable QHeaderView::section {
    border: none;
    border-bottom: 1px solid #3c4043;
    border-right: 1px solid #3c4043;
    padding: 6px;
    font-weight: bold;
}

/* Occorrenze: rende trasparenti le label interne per far passare il colore del paintEvent */
app--OccurrenceWidget QLabel,
app--OccurrenceWidget QCheckBox {
    background: transparent;
    border: none;
    color: #ffffff; /* Testo bianco sui chip colorati */
}